{
  "type": "origins:multiple",
  "name": "Иммунитет к орипатии",
  "description": "По лору Arknights орипатия вас не берёт: урон ориджиниумом проходит, но болезнь (индекс и тип орипатии Bob's Originium Dream) не развивается.",
  "attribute": {
    "type": "origins:attribute",
    "modifiers": [
      {
        "attribute": "bobsoriginiumdream:oricompletelyprotect",
        "value": -1,
        "operation": "addition"
      },
      {
        "attribute": "bobsoriginiumdream:orillnessprotect",
        "value": 20,
        "operation": "addition"
      }
    ]
  },
  "illness": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "attribute @s bobsoriginiumdream:oridisease base set 0"
        },
        {
          "type": "origins:execute_command",
          "command": "attribute @s bobsoriginiumdream:orillness base set 0"
        }
      ]
    },
    "interval": 100
  }
}
