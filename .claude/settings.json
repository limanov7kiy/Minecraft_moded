{
  "extraKnownMarketplaces": {
    "universal-modder": {
      "source": {
        "source": "github",
        "repo": "rehan-remade/universal-modder"
      }
    }
  },
  "enabledPlugins": {
    "universal-modder@universal-modder": true
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "mcp__claude-code-remote__create_session"
    ]
  }
}
